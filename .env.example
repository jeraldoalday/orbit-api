ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
INVITE_EXPIRE_DAYS=7
TASK_LIST_DEFAULT_LIMIT=50
TASK_LIST_MAX_LIMIT=100
LIST_DEFAULT_LIMIT=50
LIST_MAX_LIMIT=100
ATTACHMENT_STORAGE_DIR=var/attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_TASK=20
WEBHOOK_MAX_PER_ORG=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_BACKOFF_BASE_SECONDS=60
WEBHOOK_BATCH_SIZE=50
WEBHOOK_LEASE_SECONDS=120
WEBHOOK_VALIDATE_DNS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
